title Component Diagram
left to right direction

package "Client Tier" {
  component [CLI Client] as CLI <<planned>>
}
package "Server Tier" {
  component [TCP Server] as TCP <<planned>>
  component [REST API] as REST <<planned>>
  component [Banking Service] as Bank <<planned>>
  component [Auth Service] as Auth <<planned>>
  component [Transaction Processor] as TxProc <<planned>>
}
package "Runtime Tier" {
  component [Thread Pool] as Pool <<planned>>
  component [Transaction Queue] as Queue <<planned>>
  component [Account Lock Manager] as Locks <<planned>>
  component [Session Manager] as Sessions <<planned>>
}
package "Storage Tier" {
  component [WAL Logger] as WAL
  component [Snapshot Store] as Snap
  component [Repositories] as Repos
  database "SQLite" as DB
  folder "Disk Files" as Disk
}

CLI --> TCP
REST --> Bank
TCP --> Auth
TCP --> Bank
Bank --> TxProc
TxProc --> Queue
Pool --> Queue
Pool --> Locks
Pool --> Repos
TxProc --> WAL
WAL --> Disk
Repos --> DB
Snap --> Disk
Auth --> Repos
Auth --> Sessions
@enduml
