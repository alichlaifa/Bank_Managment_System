@startuml 05_object
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam defaultFontColor #1F2937
skinparam ArrowColor #374151
skinparam ArrowFontColor #111827
skinparam ArrowFontSize 12
skinparam classBackgroundColor #F9FAFB
skinparam classBorderColor #6B7280
skinparam classArrowColor #374151
skinparam classFontColor #111827
skinparam classFontStyle bold
skinparam classAttributeFontColor #374151
skinparam packageStyle rectangle
skinparam packageBackgroundColor #EFF6FF
skinparam packageBorderColor #60A5FA
skinparam packageFontColor #1E3A8A
skinparam packageFontStyle bold
skinparam noteBackgroundColor #FEF3C7
skinparam noteBorderColor #F59E0B
skinparam noteFontColor #78350F
skinparam componentStyle rectangle
skinparam componentBackgroundColor #ECFDF5
skinparam componentBorderColor #34D399
skinparam componentFontColor #065F46
skinparam actorBackgroundColor #FCE7F3
skinparam actorBorderColor #EC4899
skinparam usecaseBackgroundColor #FEF2F2
skinparam usecaseBorderColor #F87171
skinparam sequenceLifeLineBackgroundColor #F3F4F6
skinparam sequenceLifeLineBorderColor #9CA3AF
skinparam sequenceParticipantBackgroundColor #DBEAFE
skinparam sequenceParticipantBorderColor #2563EB
skinparam sequenceArrowColor #374151
skinparam stateBackgroundColor #F0FDF4
skinparam stateBorderColor #16A34A
skinparam stateFontColor #14532D
skinparam activityBackgroundColor #FEF9C3
skinparam activityBorderColor #EAB308
skinparam databaseBackgroundColor #EDE9FE
skinparam databaseBorderColor #7C3AED
title Object Diagram — Runtime Snapshot

object "alice : Customer" as alice {
  id = CustomerId(1001)
  name = "Alice"
  role = CUSTOMER
}
object "aliceChecking : Account" as acc1 {
  id = AccountId(5001)
  ownerId = CustomerId(1001)
  balance = Money(125050)
  status = ACTIVE
}
object "aliceSavings : Account" as acc2 {
  id = AccountId(5002)
  ownerId = CustomerId(1001)
  balance = Money(500000)
  status = ACTIVE
}
object "tx1 : Transfer" as tx1 {
  id = TransactionId(9001)
  fromId = AccountId(5001)
  toId = AccountId(5002)
  amount = Money(25000)
  status = COMMITTED
}

alice --> acc1 : owns
alice --> acc2 : owns
acc1 --> tx1 : participates
acc2 --> tx1 : participates
@enduml
