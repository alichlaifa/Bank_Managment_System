title Timing — Transfer Locking / WAL Order
robust "Transfer Worker" as W
concise "Account Lock" as L
concise "WAL" as WAL
concise "Balance" as AB

W is idle
W -> W : dequeue
W is processing
L is unlocked
W -> L : lock sorted IDs
L is locked
W -> WAL : append intent
WAL is written
W -> AB : apply
AB is updated
W -> WAL : commit
WAL is committed
W -> L : unlock
L is unlocked
W is idle
@enduml
